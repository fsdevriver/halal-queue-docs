@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

title Deployment Diagram

Deployment_Node(cloud,"Cloud") {

Deployment_Node(lb,"Load Balancer") {

Container(api1,"Backend API #1")

Container(api2,"Backend API #2")

}

Deployment_Node(database,"Database") {

ContainerDb(postgres,"PostgreSQL")

ContainerDb(redis,"Redis")

}

Deployment_Node(storage,"Object Storage") {

Container(storageService,"S3 / MinIO")

}

}

Rel(api1,postgres,"SQL")
Rel(api2,postgres,"SQL")

Rel(api1,redis,"Cache")
Rel(api2,redis,"Cache")

Rel(api1,storageService,"Objects")
Rel(api2,storageService,"Objects")

@enduml